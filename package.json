{
  "private": true,
  "name": "prompt-pad",
  "description": "Shows a Svelte overlay on every web page you visit, with an options page that moves it from right to left.",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "svelte": "^5.15.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.3",
    "@tsconfig/svelte": "5.0.4",
    "@types/chrome": "^0.0.287",
    "@typescript/native": "npm:typescript@7",
    "extension": "^4.1.29",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.1.3",
    "typescript": "6.0.3"
  },
  "scripts": {
    "dev": "extension dev",
    "start": "extension start",
    "build": "extension build",
    "preview": "extension preview",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:chrome": "extension build --browser chrome",
    "build:firefox": "extension build --browser firefox",
    "build:edge": "extension build --browser edge"
  },
  "packageManager": "pnpm@12.6.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "less"
    ]
  }
}
